# PostgreSQL. On Vercel use the provider's pooled URL here and the direct URL below.
DATABASE_URL="postgresql://USER@localhost:5432/omp_api_dev"
DATABASE_URL_UNPOOLED="postgresql://USER@localhost:5432/omp_api_dev"
# Comma-separated browser origins allowed to call the API (the storefront).
CORS_ORIGINS="http://localhost:3000"
PORT=4000
# 32 random bytes, base64 — encrypts staff TOTP secrets at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STAFF_SECRET_KEY=""
# Admin app (OrderMyPrint/omp-admin) origin: invitation links and CORS for staff routes.
ADMIN_APP_URL="http://localhost:5173"
ADMIN_ORIGINS="http://localhost:5173"
# Optional cookie domain shared by admin and API, e.g. ".example.com". Cookies are Secure unless COOKIE_SECURE=false (local http only).
COOKIE_DOMAIN=""
COOKIE_SECURE="true"
