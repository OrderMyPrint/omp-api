// Order My Print — database schema (PostgreSQL).
// Source: docs repo docs/architecture/data-model.md. Phase 3 slice 1: catalogue,
// tax profiles and versioned pricing. Later slices add identity, cart, artwork,
// quotations, orders, payments, production and billing.

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is the Vercel Functions runtime (Node 22).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection for migrations; DATABASE_URL may be a pooled URL on Vercel.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// GST profile per product. Values are supplied by the business and confirmed by the CA (D-28).
model TaxProfile {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique
  hsnSac        String?   @map("hsn_sac")
  gstRate       Decimal   @map("gst_rate") @db.Decimal(5, 2)
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  note          String?
  products      Product[]

  @@map("tax_profiles")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  summary   String
  lead      String
  about     String
  imageUrl  String    @map("image_url")
  sort      Int       @default(0)
  isVisible Boolean   @default(true) @map("is_visible")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

enum QuantityMode {
  TIERS
  SIZES
}

enum UploadTiming {
  BEFORE_CART
  AFTER_CHECKOUT
  EITHER
}

model Product {
  id                String           @id @default(uuid()) @db.Uuid
  categoryId        String           @map("category_id") @db.Uuid
  category          Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug              String           @unique
  name              String
  summary           String
  lead              String
  description       String
  imageUrl          String           @map("image_url")
  sort              Int              @default(0)
  isVisible         Boolean          @default(true) @map("is_visible")
  unitOne           String           @map("unit_one")
  unitMany          String           @map("unit_many")
  turnaroundMinDays Int              @map("turnaround_min_days")
  turnaroundMaxDays Int              @map("turnaround_max_days")
  quantityMode      QuantityMode     @default(TIERS) @map("quantity_mode")
  /// Size list for SIZES products, in display order (e.g. XS…3XL).
  sizes             String[]         @default([])
  /// Example size breakdown shown on first load.
  defaultSizes      Json?            @map("default_sizes")
  uploadTiming      UploadTiming     @default(EITHER) @map("upload_timing")
  /// Key specs as [{label, value}] for display.
  specs             Json             @default("[]")
  uses              String[]         @default([])
  materials         String[]         @default([])
  taxProfileId      String           @map("tax_profile_id") @db.Uuid
  taxProfile        TaxProfile       @relation(fields: [taxProfileId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  optionGroups      OptionGroup[]
  artworkSlots      ArtworkSlot[]
  pricingVersions   PricingVersion[]
  optionRules       OptionRule[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([categoryId])
  @@map("products")
}

enum OptionGroupKind {
  SELECT
  SWATCH
  MULTISELECT
}

model OptionGroup {
  id          String          @id @default(uuid()) @db.Uuid
  productId   String          @map("product_id") @db.Uuid
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  key         String
  label       String
  /// Shorter label for price lines (e.g. "Paper" for "Choose paper stock").
  shortLabel  String?         @map("short_label")
  hint        String
  note        String?
  kind        OptionGroupKind @default(SELECT)
  stepOrder   Int             @map("step_order")
  required    Boolean         @default(true)
  /// Default option key(s) pre-selected in the configurator.
  defaultKeys String[]        @default([]) @map("default_keys")
  options     Option[]

  @@unique([productId, key])
  @@map("option_groups")
}

model Option {
  id                String      @id @default(uuid()) @db.Uuid
  groupId           String      @map("group_id") @db.Uuid
  group             OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  key               String
  label             String
  detail            String?
  /// CSS colour for SWATCH groups.
  swatch            String?
  sort              Int         @default(0)
  isAvailable       Boolean     @default(true) @map("is_available")
  /// Why an option cannot be ordered online (e.g. "Priced on quotation").
  unavailableReason String?     @map("unavailable_reason")

  @@unique([groupId, key])
  @@map("options")
}

model ArtworkSlot {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key           String
  label         String
  printArea     String   @map("print_area")
  bleedMm       Decimal? @map("bleed_mm") @db.Decimal(5, 1)
  safeMm        Decimal? @map("safe_mm") @db.Decimal(5, 1)
  acceptedTypes String[] @default(["pdf", "png", "jpg", "jpeg", "svg", "cdr"]) @map("accepted_types")
  maxMb         Int      @default(50) @map("max_mb")
  sort          Int      @default(0)

  @@unique([productId, key])
  @@map("product_artwork_slots")
}

enum PricingStatus {
  DRAFT
  /// Publishes itself at effectiveFrom (activated on the next catalogue read).
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

/// Versioned pricing document per product (docs/prd/product-catalogue-and-pricing.md §4).
/// Only one PUBLISHED version per product at a time (partial unique index in the migration).
model PricingVersion {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  versionNo     Int           @map("version_no")
  status        PricingStatus @default(DRAFT)
  effectiveFrom DateTime      @default(now()) @map("effective_from")
  effectiveTo   DateTime?     @map("effective_to")
  /// Typed pricing components — validated by src/pricing/pricing-document.ts. No code is ever evaluated.
  document      Json
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")
  publishedAt   DateTime?     @map("published_at")

  @@unique([productId, versionNo])
  @@map("pricing_versions")
}

// ---------------------------------------------------------------------------
// Identity, staff access control (RBAC) and audit — Phase 3 slice 2.
// Customers (mobile + OTP) share the users table later; staff sign in with
// email + password + TOTP (docs repo: architecture.md §2, admin-audit-2026-11-05.md).
// ---------------------------------------------------------------------------

enum UserKind {
  CUSTOMER
  STAFF
}

enum StaffStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  kind             UserKind
  /// Stored lower-case. Required for staff (check constraint).
  email            String?           @unique
  phoneE164        String?           @unique @map("phone_e164")
  name             String
  passwordHash     String?           @map("password_hash")
  /// AES-256-GCM encrypted base32 secret (STAFF_SECRET_KEY). Set but not enabled during enrolment.
  totpSecretEnc    String?           @map("totp_secret_enc")
  totpEnabledAt    DateTime?         @map("totp_enabled_at")
  /// Last accepted TOTP time-step; a code is never accepted twice (replay protection).
  totpLastStep     Int?              @map("totp_last_step")
  staffStatus      StaffStatus?      @map("staff_status")
  roleId           String?           @map("role_id") @db.Uuid
  role             Role?             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  failedLogins     Int               @default(0) @map("failed_logins")
  lockedUntil      DateTime?         @map("locked_until")
  lastActiveAt     DateTime?         @map("last_active_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  sessions         StaffSession[]
  customerSessions CustomerSession[]
  cart             Cart?
  orders           Order[]
  invitations      StaffInvitation[] @relation("InvitedUser")

  @@index([roleId])
  @@map("users")
}

/// A staff role: a named bundle of permission keys (src/auth/permissions.ts).
/// The system Owner role always holds every permission and cannot be edited or deleted.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String   @unique
  description String   @default("")
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]

  @@map("staff_roles")
}

model StaffSession {
  id            String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash     String    @unique @map("token_hash")
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaVerifiedAt DateTime? @map("mfa_verified_at")
  stepUpAt      DateTime? @map("step_up_at")
  csrfToken     String    @map("csrf_token")
  ip            String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")

  @@index([userId])
  @@map("staff_sessions")
}

model StaffInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("staff_invitations")
}

/// Append-only (UPDATE/DELETE blocked by trigger). Never store secrets or tokens here.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorKind  String   @map("actor_kind")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  at         DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([at])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Website content (admin AD-WEB-01…06) — Phase 3 slice 3.
// Pages are typed section documents (no raw HTML), versioned draft → published.
// ---------------------------------------------------------------------------

enum PageType {
  HOMEPAGE
  CONTENT
  SYSTEM
  POLICY
  LANDING
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContentPage {
  id        String               @id @default(uuid()) @db.Uuid
  /// Stable identifier used by the storefront, e.g. "home", "about", "policy-shipping".
  key       String               @unique
  /// Public path, e.g. "/", "/about", "/policies/shipping".
  path      String               @unique
  title     String
  type      PageType             @default(CONTENT)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  versions  ContentPageVersion[]

  @@map("content_pages")
}

model ContentPageVersion {
  id            String        @id @default(uuid()) @db.Uuid
  pageId        String        @map("page_id") @db.Uuid
  page          ContentPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  versionNo     Int           @map("version_no")
  status        ContentStatus @default(DRAFT)
  /// { title, seo, blocks[] } — validated by src/content/page-document.ts.
  document      Json
  createdById   String?       @map("created_by_id") @db.Uuid
  publishedById String?       @map("published_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  publishedAt   DateTime?     @map("published_at")

  @@unique([pageId, versionNo])
  @@map("content_page_versions")
}

/// Header utility links, category bar and footer columns; draft and published copies.
model NavigationMenu {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  draft       Json
  published   Json?
  publishedAt DateTime? @map("published_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("navigation_menus")
}

/// Single row ("site"): brand, contact details, announcement bar, SEO defaults.
model SiteSettings {
  id          String    @id @default("site")
  draft       Json
  published   Json?
  publishedAt DateTime? @map("published_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("site_settings")
}

model FaqTopic {
  id    String    @id @default(uuid()) @db.Uuid
  key   String    @unique
  title String
  sort  Int       @default(0)
  items FaqItem[]

  @@map("faq_topics")
}

model FaqItem {
  id             String   @id @default(uuid()) @db.Uuid
  topicId        String   @map("topic_id") @db.Uuid
  topic          FaqTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  question       String
  answer         String
  sort           Int      @default(0)
  showOnHomepage Boolean  @default(false) @map("show_on_homepage")
  isPublished    Boolean  @default(true) @map("is_published")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([topicId])
  @@map("faq_items")
}

/// Images used on pages. Upload to object storage arrives with D-05; until then
/// assets reference files already shipped with the storefront (e.g. /images/hero.png).
model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  url       String   @unique
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  width     Int?
  height    Int?
  sizeBytes Int?     @map("size_bytes")
  /// Required before an image can appear on a published page.
  alt       String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media_assets")
}

model Redirect {
  id        String   @id @default(uuid()) @db.Uuid
  fromPath  String   @unique @map("from_path")
  toPath    String   @map("to_path")
  permanent Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("redirects")
}

enum RuleEffect {
  /// When the trigger option is chosen, none of the target options may be chosen.
  EXCLUDES
  /// When the trigger option is chosen, the target group must use one of the target options.
  REQUIRES
}

/// Constraint rule between two option groups (AD-CAT-04), enforced by the pricing engine.
model OptionRule {
  id          String     @id @default(uuid()) @db.Uuid
  productId   String     @map("product_id") @db.Uuid
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  whenGroup   String     @map("when_group")
  whenOption  String     @map("when_option")
  effect      RuleEffect
  thenGroup   String     @map("then_group")
  thenOptions String[]   @map("then_options")
  /// Shown to customers when the rule blocks a combination.
  message     String
  sort        Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([productId])
  @@map("option_rules")
}

// ------------------------------------------------------------------ customers

/// One-time code sent by SMS for customer sign-in (X-09). Only a hash of the code is stored.
model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phoneE164   String    @map("phone_e164")
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  /// Set after too many wrong codes; new codes are refused until then.
  lockedUntil DateTime? @map("locked_until")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phoneE164, createdAt])
  @@map("otp_challenges")
}

model CustomerSession {
  id         String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken  String    @map("csrf_token")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("customer_sessions")
}

// ------------------------------------------------------------------ cart

/// A guest cart is found by its cookie token; a signed-in cart by its user. Guest carts merge on sign-in.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  tokenHash String?    @unique @map("token_hash")
  userId    String?    @unique @map("user_id") @db.Uuid
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  cart             Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId        String   @map("product_id") @db.Uuid
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Selections, quantity or sizes, colours — the configurator input.
  configuration    Json
  /// Price when added (catalogue doc §4.4: re-priced at checkout, changes shown to the customer).
  priceSnapshot    Json     @map("price_snapshot")
  pricingVersionId String   @map("pricing_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([cartId])
  @@map("cart_items")
}

// ------------------------------------------------------------------ orders

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  IN_PRODUCTION
  READY_TO_DISPATCH
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
}

enum RefundStatus {
  REQUESTED
  PROCESSED
}

/// Yearly order-number counter (OMP-2026-000001).
model OrderSequence {
  year Int @id
  last Int @default(0)

  @@map("order_sequences")
}

model Order {
  id                 String       @id @default(uuid()) @db.Uuid
  orderNumber        String       @unique @map("order_number")
  userId             String       @map("user_id") @db.Uuid
  user               User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  status             OrderStatus  @default(AWAITING_PAYMENT)
  /// Client-supplied key so a retried "Place order" never creates a second order.
  idempotencyKey     String       @map("idempotency_key")
  /// {name, phone, email}
  contact            Json
  billingAddress     Json         @map("billing_address")
  shippingAddress    Json         @map("shipping_address")
  gstin              String?
  companyName        String?      @map("company_name")
  placeOfSupplyState String       @map("place_of_supply_state")
  subtotal           Decimal      @db.Decimal(12, 2)
  discountTotal      Decimal      @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal      Decimal      @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal           Decimal      @map("tax_total") @db.Decimal(12, 2)
  grandTotal         Decimal      @map("grand_total") @db.Decimal(12, 2)
  currency           String       @default("INR")
  onHold             Boolean      @default(false) @map("on_hold")
  holdReason         String?      @map("hold_reason")
  holdReviewOn       DateTime?    @map("hold_review_on")
  cancelReason       String?      @map("cancel_reason")
  cancelledAt        DateTime?    @map("cancelled_at")
  placedAt           DateTime     @default(now()) @map("placed_at")
  paidAt             DateTime?    @map("paid_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  items              OrderItem[]
  events             OrderEvent[]
  payments           Payment[]
  refunds            Refund[]

  @@unique([userId, idempotencyKey])
  @@index([status, placedAt])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String          @map("product_id") @db.Uuid
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName      String          @map("product_name")
  /// What was ordered (labels and keys) — immutable (trigger).
  specSnapshot     Json            @map("spec_snapshot")
  /// Every price line and total as charged — immutable (trigger).
  priceSnapshot    Json            @map("price_snapshot")
  pricingVersionId String          @map("pricing_version_id") @db.Uuid
  quantity         Int
  unitPrice        Decimal         @map("unit_price") @db.Decimal(12, 4)
  lineSubtotal     Decimal         @map("line_subtotal") @db.Decimal(12, 2)
  gstRate          Decimal         @map("gst_rate") @db.Decimal(5, 2)
  taxAmount        Decimal         @map("tax_amount") @db.Decimal(12, 2)
  lineTotal        Decimal         @map("line_total") @db.Decimal(12, 2)
  status           OrderItemStatus @default(ACTIVE)
  cancelledAt      DateTime?       @map("cancelled_at")

  @@index([orderId])
  @@map("order_items")
}

/// Order timeline: status changes, holds, payments and notes, by customer, staff or system.
model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  message   String
  detail    Json?
  actorKind String   @map("actor_kind")
  actorId   String?  @map("actor_id") @db.Uuid
  at        DateTime @default(now())

  @@index([orderId, at])
  @@map("order_events")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider    String
  providerRef String        @map("provider_ref")
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(CREATED)
  method      String?
  createdAt   DateTime      @default(now()) @map("created_at")
  capturedAt  DateTime?     @map("captured_at")
  failedAt    DateTime?     @map("failed_at")
  refunds     Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payments")
}

/// Every webhook the gateway sends, verified or not. The unique event id makes processing idempotent.
model PaymentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String   @map("event_id")
  kind        String
  providerRef String?  @map("provider_ref")
  orderId     String?  @map("order_id") @db.Uuid
  amount      Decimal? @db.Decimal(12, 2)
  verified    Boolean
  /// applied · duplicate · ignored · rejected
  outcome     String
  payload     Json
  receivedAt  DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@index([orderId])
  @@map("payment_events")
}

/// Money owed back after a cancellation; completed in Payments & refunds (AD-PAY-02, Phase 6).
model Refund {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId     String?      @map("payment_id") @db.Uuid
  payment       Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  status        RefundStatus @default(REQUESTED)
  requestedById String?      @map("requested_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")

  @@index([orderId])
  @@map("refunds")
}
